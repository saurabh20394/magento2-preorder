<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Saurabh_Preorder::css/preorder.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Saurabh\Preorder\Block\Product\ProductList" name="saurabh.preorder.list" after="-">
                <arguments>
                    <argument name="list_block" xsi:type="string">category.products.list</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
