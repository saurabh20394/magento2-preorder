<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_order" resource="sales">
        <column xsi:type="smallint" name="saurabh_is_preorder" unsigned="true" nullable="false" default="0"
                comment="Order Contains Pre-Order Items"/>
        <column xsi:type="smallint" name="saurabh_preorder_status_off" unsigned="true" nullable="false" default="0"
                comment="Pre-Order Status Assignment Disabled By Admin"/>
    </table>
    <table name="sales_order_grid" resource="sales">
        <column xsi:type="smallint" name="saurabh_is_preorder" unsigned="true" nullable="false" default="0"
                comment="Order Contains Pre-Order Items"/>
        <index referenceId="SALES_ORDER_GRID_SAURABH_IS_PREORDER" indexType="btree">
            <column name="saurabh_is_preorder"/>
        </index>
    </table>
    <table name="sales_order_item" resource="sales">
        <column xsi:type="smallint" name="saurabh_preorder" unsigned="true" nullable="false" default="0"
                comment="Is Pre-Order Item"/>
        <column xsi:type="text" name="saurabh_preorder_note" nullable="true" comment="Pre-Order Note"/>
    </table>
</schema>
