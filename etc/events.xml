<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_item_qty_set_after">
        <observer name="saurabh_preorder_validate_qty" instance="Saurabh\Preorder\Observer\ValidateQuoteItemQty"/>
    </event>
    <event name="sales_quote_product_add_after">
        <observer name="saurabh_preorder_mixed_cart" instance="Saurabh\Preorder\Observer\RestrictMixedCart"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="saurabh_preorder_mark_order" instance="Saurabh\Preorder\Observer\MarkPreorderOrder"/>
    </event>
    <event name="sales_order_save_before">
        <observer name="saurabh_preorder_status" instance="Saurabh\Preorder\Observer\AssignPreorderStatus"/>
    </event>
</config>
