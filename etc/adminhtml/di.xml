<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="saurabh_preorder" xsi:type="array">
                    <item name="class" xsi:type="string">Saurabh\Preorder\Ui\DataProvider\Product\Form\Modifier\Preorder</item>
                    <item name="sortOrder" xsi:type="number">1000</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!-- mark pre-order items on admin order / invoice / shipment / credit memo pages -->
    <type name="Magento\Sales\Block\Adminhtml\Items\Column\DefaultColumn">
        <plugin name="saurabh_preorder_item_options" type="Saurabh\Preorder\Plugin\Sales\AdminItemOptionsPlugin"/>
    </type>
    <type name="Magento\Bundle\Block\Adminhtml\Sales\Order\View\Items\Renderer">
        <plugin name="saurabh_preorder_item_options" type="Saurabh\Preorder\Plugin\Sales\AdminItemOptionsPlugin"/>
    </type>
    <type name="Magento\Bundle\Block\Adminhtml\Sales\Order\Items\Renderer">
        <plugin name="saurabh_preorder_item_options" type="Saurabh\Preorder\Plugin\Sales\AdminItemOptionsPlugin"/>
    </type>

    <!-- "Pre-Order" condition in catalog and cart price rules -->
    <type name="Magento\CatalogRule\Model\Rule\Condition\Combine">
        <plugin name="saurabh_preorder_condition" type="Saurabh\Preorder\Plugin\Rule\AddConditionPlugin"/>
    </type>
    <type name="Magento\SalesRule\Model\Rule\Condition\Product\Combine">
        <plugin name="saurabh_preorder_condition" type="Saurabh\Preorder\Plugin\Rule\AddConditionPlugin"/>
    </type>
</config>
